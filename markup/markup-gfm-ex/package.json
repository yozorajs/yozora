{
  "name": "@yozora/markup-gfm-ex",
  "version": "3.0.0-alpha",
  "description": "Serialize GFM AST nodes and extensions into Markdown.",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora.git",
    "directory": "markup/markup-gfm-ex"
  },
  "homepage": "https://github.com/yozorajs/yozora/tree/v3.0.0-alpha/markup/markup-gfm-ex#readme",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs",
    "clean": "rimraf lib",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  },
  "exports": {
    "types": "./lib/types/index.d.ts",
    "import": "./lib/esm/index.mjs",
    "require": "./lib/cjs/index.cjs"
  },
  "source": "./src/index.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./lib/types/index.d.ts",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@yozora/ast": "workspace:^",
    "@yozora/markup": "workspace:^",
    "@yozora/markup-gfm": "workspace:^"
  }
}
