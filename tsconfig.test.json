{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "markup/*/src",
    "markup/*/__test__",
    "packages/*/src",
    "packages/*/__test__",
    "parsers/*/src",
    "parsers/*/__test__",
    "tokenizers/*/src",
    "tokenizers/*/__test__",
    "script/**/*.ts",
    "script/docs/*.mjs",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
